---
interface Props {
	href: string;
	title: string;
	description: string;
	date: string;
	datetime: string;
	minutes: number;
	tags?: string[];
}

const { href, title, description, date, datetime, minutes, tags = [] } = Astro.props;
---

<a
	href={href}
	class="post-row no-underline group block border-b border-gray-200 dark:border-gray-800 py-5 px-3 -mx-3 rounded-lg transition-colors hover:bg-gray-50 dark:hover:bg-white/[0.04]"
>
	<div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-6">
		<time
			datetime={datetime}
			class="shrink-0 sm:w-28 text-xs text-gray-500 dark:text-gray-400 tabular-nums whitespace-nowrap"
			>{date}</time
		>
		<div class="min-w-0 flex-1">
			<div class="flex items-baseline gap-2">
				<strong
					class="text-base text-gray-900 dark:text-gray-100 transition-colors group-hover:text-[rgb(var(--accent))]"
					>{title}</strong
				>
				<span
					aria-hidden="true"
					class="post-row__arrow shrink-0 text-[rgb(var(--accent))] opacity-0 transition-all duration-300 group-hover:opacity-100 group-hover:translate-x-1"
					>&rarr;</span
				>
			</div>
			<p class="mt-1 mb-2 text-sm text-gray-500 dark:text-gray-300">{description}</p>
			<div
				class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-gray-500 dark:text-gray-400"
			>
				{tags.map((tag) => <span class="whitespace-nowrap"><span style="color: rgb(var(--accent-light))">#</span>{tag}</span>)}
				<span class="whitespace-nowrap">{minutes} min read</span>
			</div>
		</div>
	</div>
</a>

<style>
	/* Keyboard parity: focus gets the same wash + arrow as hover. */
	.post-row:focus-visible {
		outline: 2px solid rgb(var(--accent));
		outline-offset: 2px;
	}

	.post-row:focus-visible .post-row__arrow {
		opacity: 1;
		transform: translateX(0.25rem);
	}

	@media (prefers-reduced-motion: reduce) {
		.post-row__arrow {
			transition-duration: 150ms;
			transition-property: opacity;
		}

		.post-row:hover .post-row__arrow,
		.post-row:focus-visible .post-row__arrow {
			transform: none;
		}
	}
</style>
