---
interface Props {
  title: string;
  location: string;
  date: string;
  description: string;
  linkHref: string;
  linkText: string;
}

const { title, location, date, description, linkHref, linkText } = Astro.props;
---

<div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-6 py-5 border-b border-gray-200 dark:border-gray-800">
  <span class="shrink-0 sm:w-28 text-xs text-gray-500 dark:text-gray-400 tabular-nums whitespace-nowrap">{date}</span>
  <div class="min-w-0 flex-1">
    <strong class="text-base text-gray-900 dark:text-gray-100">{title}</strong>
    <div class="text-xs text-gray-500 dark:text-gray-400 mt-1">{location}</div>
    <p class="mt-2 mb-2">{description}</p>
    <a href={linkHref} class="text-sm font-medium">{linkText} ↗</a>
  </div>
</div>
