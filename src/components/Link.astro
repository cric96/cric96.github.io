---
interface Props {
	href: string;
	icon: string;
}
import { Icon } from "astro-icon/components";
const { href, icon } = Astro.props;
---

<a
	href={href}
	class="no-underline inline-block transition-transform duration-300 hover:scale-110 hover:-translate-y-1"
	><Icon name={icon} size="40" />
</a>
