---
import { Icon } from 'astro-icon/components';

interface Props {
	title: string;
	venue: string;
	year: number;
	image?: { square: string; rectangle: string };
	description: string;
	authors: string;
	doi?: string;
	featured?: boolean;
}

const { title, venue, year, image, description, authors, doi, featured } = Astro.props;

const ME = 'Gianluca Aguzzi';

// Generate a deterministic gradient based on the title length and characters
const hash = title.split('').reduce((acc, char) => char.charCodeAt(0) + ((acc << 5) - acc), 0);
const colors = [
	'rgba(var(--accent), 0.15)',
	'rgba(var(--accent-light), 0.15)',
	'rgba(var(--accent-dark), 0.15)'
];
const color1 = colors[Math.abs(hash) % colors.length];
const color2 = colors[Math.abs(hash + 1) % colors.length];
const angle = Math.abs(hash) % 360;
const gradientStyle = `background: linear-gradient(${angle}deg, ${color1}, ${color2});`;
---

<div class="p-4 border border-gray-200 dark:border-gray-800 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors flex flex-col sm:flex-row gap-4 sm:gap-5">
  {image?.square || image?.rectangle ? (
    <picture class="flex-shrink-0">
      {/* One download: wide crop on phones, square thumbnail from sm up. */}
      <source media="(min-width: 640px)" srcset={image.square || image.rectangle} />
      <img src={image.rectangle || image.square} alt="" loading="lazy" class="w-full h-40 sm:w-32 sm:h-32 rounded object-cover shadow-sm" />
    </picture>
  ) : (
    <div class="w-full h-40 sm:w-32 sm:h-32 rounded shadow-sm flex-shrink-0" style={gradientStyle}></div>
  )}
  <div class="flex-1 min-w-0">
    <div class="flex items-start justify-between gap-2">
      <strong class="text-base text-gray-900 dark:text-gray-100">{title}</strong>
      {featured && (
        <span class="flex-shrink-0 text-yellow-500" title="Featured Publication">
          <Icon name="mdi:star" class="w-5 h-5" />
        </span>
      )}
    </div>
    <div class="text-xs text-gray-500 dark:text-gray-400 mt-1 mb-2">{venue} • {year}</div>
    <div class="text-sm text-gray-500 dark:text-gray-400 mb-2 italic">
      {authors.split(ME).map((part, i) => (
        <>{i > 0 && <span class="font-medium text-gray-800 dark:text-gray-200">{ME}</span>}{part}</>
      ))}
    </div>
    {doi && (
      <div class="mb-2">
        <a href={`https://doi.org/${doi}`} target="_blank" rel="noopener noreferrer" class="text-xs">
          DOI: {doi}
        </a>
      </div>
    )}
    <p class="mt-1 mb-3">{description}</p>
  </div>
</div>
